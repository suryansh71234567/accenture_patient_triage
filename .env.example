# Copy this file to .env and fill in real values. Never commit the real .env
# (it is already listed in .gitignore).

# Required for the RAG branch (triageguard_rag) AND the conversational agent's
# LLM planning loop (triageguard_agent/llm/openrouter_client.py) — both call
# OpenRouter, independently.
OPENROUTER_API_KEY=

# Optional. Model used by the nurse-facing agent's tool-calling loop.
# Must be an OpenRouter model that supports function/tool calling.
# Defaults to meta-llama/llama-3.1-8b-instruct if unset.
TRIAGEGUARD_AGENT_MODEL=meta-llama/llama-3.1-8b-instruct
